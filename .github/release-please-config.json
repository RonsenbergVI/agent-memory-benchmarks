{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Maintenance" },
    { "type": "build", "section": "Maintenance" },
    { "type": "ci", "section": "Maintenance" },
    { "type": "chore", "section": "Maintenance" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "python",
      "component": "python",
      "tag-separator": "/",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "alpha",
      "bump-minor-pre-major": true,
      "release-as": "0.1.0-alpha.1",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name=='amb')].version"
        }
      ]
    },
    "benchmarks/fraise": {
      "release-type": "python",
      "component": "fraise",
      "tag-separator": "/",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='fraise')].version"
        }
      ]
    },
    "benchmarks/graphiti": {
      "release-type": "python",
      "component": "graphiti",
      "tag-separator": "/",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='graphiti')].version"
        }
      ]
    },
    "benchmarks/letta": {
      "release-type": "python",
      "component": "letta",
      "tag-separator": "/",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='letta')].version"
        }
      ]
    },
    "benchmarks/mem0": {
      "release-type": "python",
      "component": "mem0",
      "tag-separator": "/",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='mem0')].version"
        }
      ]
    }
  }
}
