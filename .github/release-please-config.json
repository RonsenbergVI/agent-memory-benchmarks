{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Maintenance" },
    { "type": "build", "section": "Maintenance" },
    { "type": "ci", "section": "Maintenance" },
    { "type": "chore", "section": "Maintenance" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "python",
      "component": "python",
      "tag-separator": "/",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "versioning": "always-bump-minor",
      "exclude-paths": [
        ".claude",
        ".data",
        ".dockerignore",
        ".github/.release-please-manifest.json",
        ".github/ISSUE_TEMPLATE",
        ".github/PULL_REQUEST_TEMPLATE.md",
        ".github/dependabot.yaml",
        ".github/labeler.yaml",
        ".github/release-please-config.json",
        ".gitignore",
        ".pre-commit-config.yaml",
        ".python-version",
        "AGENTS.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "METHODOLOGY.md",
        "Makefile",
        "README.md",
        "RESULTS.md",
        "plots",
        "runs",
        "tests",
        "uv.lock"
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name=='amb')].version"
        }
      ]
    },
    "benchmarks/fraise": {
      "release-type": "python",
      "component": "fraise",
      "tag-separator": "/",
      "versioning": "always-bump-minor",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='fraise')].version"
        }
      ]
    },
    "benchmarks/graphiti": {
      "release-type": "python",
      "component": "graphiti",
      "tag-separator": "/",
      "versioning": "always-bump-minor",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='graphiti')].version"
        }
      ]
    },
    "benchmarks/letta": {
      "release-type": "python",
      "component": "letta",
      "tag-separator": "/",
      "versioning": "always-bump-minor",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='letta')].version"
        }
      ]
    },
    "benchmarks/mem0": {
      "release-type": "python",
      "component": "mem0",
      "tag-separator": "/",
      "versioning": "always-bump-minor",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='mem0')].version"
        }
      ]
    }
  }
}
