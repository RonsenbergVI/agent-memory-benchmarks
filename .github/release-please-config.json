{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Maintenance" },
    { "type": "build", "section": "Maintenance" },
    { "type": "ci", "section": "Maintenance" },
    { "type": "chore", "section": "Maintenance" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "python",
      "component": "python",
      "tag-separator": "/",
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "alpha",
      "bump-minor-pre-major": true,
      "release-as": "0.1.0-alpha.1",
      "extra-files": [
        "benchmarks/fraise/pyproject.toml",
        "benchmarks/graphiti/pyproject.toml",
        "benchmarks/letta/pyproject.toml",
        "benchmarks/mem0/pyproject.toml"
      ]
    }
  }
}
